# Скопировать в .env и заполнить. Секреты в git не попадают (см. .gitignore).

# Приложение подключается ролью app_user (без BYPASSRLS) — RLS работает.
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5432/lola

# Миграции и сид идут от владельца БД (обходит RLS осознанно).
DATABASE_ADMIN_URL=postgres://lola:lola_dev@localhost:5432/lola

# S3 (MinIO в dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lola-media
S3_ACCESS_KEY=lola
S3_SECRET_KEY=lola_dev_secret

# Секреты приложения (в dev — любые, в prod генерируются make secrets)
SESSION_SECRET=dev-session-secret-change-me
ENCRYPTION_KEY=dev-encryption-key-change-me
OTP_PEPPER=dev-otp-pepper-change-me

TZ=Europe/Kyiv

# Панель оператора: роль с BYPASSRLS, только для модуля платформы (docs/02 §2.12)
PLATFORM_DATABASE_URL=postgres://platform_admin:platform_admin_dev@localhost:5432/lola
# Первый оператор платформы создаётся сидом: PLATFORM_ADMIN_EMAIL / PLATFORM_ADMIN_PASSWORD
PLATFORM_ADMIN_EMAIL=ops@lola.local
PLATFORM_ADMIN_PASSWORD=change-me-in-prod

# OAuth-провайдеры (docs/09 §9.2). Без ключей панель показывает «Не налаштовано»
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
NUXT_PUBLIC_DEFAULT_TENANT=kappi

# Наблюдаемость (docs/06 §6.7): /metrics отдаётся по Bearer METRICS_TOKEN (без токена — только с localhost/docker-сети); Sentry — при SENTRY_DSN
METRICS_TOKEN=
SENTRY_DSN=
# Геолокация в журналах (CLAUDE.md п. 14): путь к MaxMind GeoLite2-City.mmdb; пусто — geo не пишется
GEOIP_DB_PATH=
# VIDEO_TRANSCODE=0 — отключить перекодирование видео в 720p (нужен ffmpeg в воркере)

# Контакт поддержки в подвале экрана входа (до настроек тенанта, docs/24 §3.1)
NUXT_PUBLIC_SUPPORT_CONTACT=

# Тенант по Host (docs/25 §16.1, Spec 25): <slug>.<TENANT_HOST_BASE> → тенант, неизвестный поддомен — 404.
# TENANT_HOST_DEFAULT — хосты (через запятую), которые ведут в NUXT_PUBLIC_DEFAULT_TENANT (стенд: lms.lmscappi.pp.ua).
# Пусто — резолв по Host выключен, тенант только из сессии.
TENANT_HOST_BASE=
TENANT_HOST_DEFAULT=
# Через сколько дней после команды оператора задача tenant.purge удаляет данные (docs/25 §8)
TENANT_PURGE_DELAY_DAYS=30

# Push-уведомления PWA (docs/23 §4, докс/33 D-051). Пара VAPID (RFC 8292): публичный —
# 65 байт несжатой точки P-256, base64url (совпадает с NUXT_PUBLIC_VAPID_PUBLIC_KEY);
# приватный — 32-байтовый скаляр d, base64url. Сгенерировать без npm-пакетов:
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});const j=k.privateKey.export({format:'jwk'});const b=x=>Buffer.from(x,'base64url');console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),b(j.x),b(j.y)]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+j.d)"
# Без пары — канал push пропускает отправку (skipped), остальные каналы не затронуты.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@lola.app
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
