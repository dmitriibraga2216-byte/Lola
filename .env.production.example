# Прод (docs/26 §26.5, «Розгортання R1»). Копия в ~/lola-prod/.env, права 600.
# Секреты генерирует scripts/gen-env.sh (аналог make secrets из docs/26 §26.6).
NODE_ENV=production
# R1 (docs/32 §Г.1, домен lmscappi.pp.ua): прод на app.<TENANT_HOST_BASE>, тенанты — на
# <slug>.<TENANT_HOST_BASE> (см. TENANT_HOST_* ниже). APP_HOST не используется без профиля
# `public` (Caddy) — в R1 вход терминирует Cloudflare Tunnel, см. docker-compose.prod.yml.
APP_URL=https://app.lmscappi.pp.ua
APP_HOST=app.lola.local
PORT=3000

# Образ приложения (job `image` в .github/workflows/ci.yml): APP_TAG=latest — то, что собрал
# CI на main; APP_TAG=<sha> — конкретный коммит для отката (scripts/deploy-prod.sh, make rollback).
APP_IMAGE=ghcr.io/dmitriibraga2216-byte/lola
APP_TAG=latest
# Каталог с данными БД/MinIO/Caddy (docker-compose.prod.yml, относительно ~/lola-prod)
# и каталог с config.yml + credentials тунеля Cloudflare (docs/27 §27.4) — оба вне git.
DATA_DIR=./data
CF_DIR=./cf

POSTGRES_USER=lola
POSTGRES_PASSWORD=
POSTGRES_DB=lola
# Приложение — app_user без BYPASSRLS; платформа — platform_admin. Пароли ролям задать после migrate:
#   ALTER ROLE app_user PASSWORD '...'; ALTER ROLE platform_admin PASSWORD '...';
DATABASE_URL=postgres://app_user:CHANGE_ME@db:5432/lola
DATABASE_ADMIN_URL=postgres://lola:${POSTGRES_PASSWORD}@db:5432/lola
PLATFORM_DATABASE_URL=postgres://platform_admin:CHANGE_ME@db:5432/lola
DB_POOL_MAX=20

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=lola-media
S3_ACCESS_KEY=lola
S3_SECRET_KEY=

SESSION_SECRET=
ENCRYPTION_KEY=
OTP_PEPPER=
COOKIE_SECURE=1

PLATFORM_ADMIN_EMAIL=ops@lola.example.com
PLATFORM_ADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SMTP_URL=
SMTP_FROM=lola@example.com
# Провайдер модели платформы и эмбеддинги (docs/v2/30 §3.2, PR-27): базовый адрес OpenAI-
# совместимого API (https://…/v1) и ключ. Кто отвечает за роль — решает профиль ai_providers
# тенанта (по умолчанию заглушка); ключ платформы уходит только на свой адрес. См. .env.example.
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=
SIGNUP_ENABLED=0
# SMS-провайдер (docs/09 §9.1) в коде не реализован как глобальная интеграция: ключи хранятся
# в tenant_secrets на тенанта (шифруются ENCRYPTION_KEY), настраиваются в панели тенанта после
# первого входа — глобального SMS_API_KEY/SMS_PROVIDER в env нет (grep process.env.SMS не находит).
# До подключения канала код входа пишется в лог только при OTP_DEBUG=1 (в проде не выставлять).

# Тунель Cloudflare (docs/27 §27.4): именованный тунель, конфиг и файл credentials — вне git,
# в каталоге CF_DIR (см. выше), токен в .env не нужен (используется credentials-file в config.yml).

SENTRY_DSN=
GEOIP_DB_PATH=/opt/lola/GeoLite2-City.mmdb
LOG_LEVEL=info
TZ=Europe/Kyiv

# OAuth (docs/09 §9.2): redirect URI = ${APP_URL}/api/v1/integrations/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# /metrics отдаётся по Bearer METRICS_TOKEN (без токена — только с localhost/docker-сети)
METRICS_TOKEN=
# VIDEO_TRANSCODE=0 — отключить перекодирование видео в 720p

# Тенант по Host (docs/25 §16.1, Spec 25): <slug>.<TENANT_HOST_BASE> → тенант, неизвестный поддомен — 404.
# TENANT_HOST_DEFAULT — хосты (через запятую), которые ведут в NUXT_PUBLIC_DEFAULT_TENANT (стенд: lms.lmscappi.pp.ua).
# Пусто — резолв по Host выключен, тенант только из сессии.
TENANT_HOST_BASE=
TENANT_HOST_DEFAULT=
# Отдельный хост консоли оператора (docs/25 §7 п. 6): только /ops/* и /api/v1/platform/*; на остальных хостах — 404
# Прод: ops.lmscappi.pp.ua — включать после маршрута в туннеле (иначе консоль станет недоступна). Пусто — консоль по пути /ops
OPS_HOST=
# Через сколько дней после команды оператора задача tenant.purge удаляет данные (docs/25 §8)
TENANT_PURGE_DELAY_DAYS=30

# Push-уведомления PWA (docs/23 §4, докс/33 D-051) — пара VAPID, см. .env.example для генерации
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@lola.app
NUXT_PUBLIC_VAPID_PUBLIC_KEY=

# Первый запуск прода (scripts/first-run-prod.sh, server/db/seed.ts): SEED_MODE=prod сеет
# минимальный тенант без демо-контента (в отличие от dev/demo, где сеется тенант «Каппі»).
# Не используется после первого запуска — оператор дальше заводит тенантов через панель платформы.
SEED_MODE=prod
FIRST_TENANT_SLUG=
# ^ [a-z0-9-]{3,80} (docs/24 §slugSchema) — станет поддоменом <slug>.<TENANT_HOST_BASE>
FIRST_TENANT_NAME=
FIRST_ADMIN_PHONE=
# ^ E.164, например +380XXXXXXXXX — по этому номеру входит первый администратор тенанта
