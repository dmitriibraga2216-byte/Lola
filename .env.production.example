# Прод (docs/26 §26.5). Копия в /srv/lola/secrets/.env, права 600. Секреты генерирует make secrets.
NODE_ENV=production
APP_URL=https://app.lola.example.com
APP_HOST=app.lola.local
PORT=3000

POSTGRES_USER=lola
POSTGRES_PASSWORD=
POSTGRES_DB=lola
# Приложение — app_user без BYPASSRLS; платформа — platform_admin. Пароли ролям задать после migrate:
#   ALTER ROLE app_user PASSWORD '...'; ALTER ROLE platform_admin PASSWORD '...';
DATABASE_URL=postgres://app_user:CHANGE_ME@db:5432/lola
DATABASE_ADMIN_URL=postgres://lola:${POSTGRES_PASSWORD}@db:5432/lola
PLATFORM_DATABASE_URL=postgres://platform_admin:CHANGE_ME@db:5432/lola
DB_POOL_MAX=20

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=lola-media
S3_ACCESS_KEY=lola
S3_SECRET_KEY=

SESSION_SECRET=
ENCRYPTION_KEY=
OTP_PEPPER=
COOKIE_SECURE=1

PLATFORM_ADMIN_EMAIL=ops@lola.example.com
PLATFORM_ADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SMTP_URL=
SMTP_FROM=lola@example.com
EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=
SIGNUP_ENABLED=0
CF_TUNNEL_TOKEN=

SENTRY_DSN=
LOG_LEVEL=info
TZ=Europe/Kyiv
DATA_DIR=/srv/lola/data

# OAuth (docs/09 §9.2): redirect URI = ${APP_URL}/api/v1/integrations/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# /metrics отдаётся по Bearer METRICS_TOKEN (без токена — только с localhost/docker-сети)
METRICS_TOKEN=
# VIDEO_TRANSCODE=0 — отключить перекодирование видео в 720p
